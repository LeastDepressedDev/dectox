{
  "name": "dectox",
  "displayName": "DecTox",
  "description": "VS code: code decoration",
  "publisher": "LeastDepressedDev",
  "author": "LeastDepressedDev",
  "version": "0.0.3",
  "repository": "https://github.com/LeastDepressedDev/dectox",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./build/extension.js",
  "contributes": {
    "commands": [
      {
        "title": "Choose picture to place picture",
        "command": "dectox.ChoosePlacePicture"
      },
      {
        "title": "Place",
        "command": "dectox.PlacePic"
      },
      {
        "title": "Enforce smart tab",
        "command": "dectox.smartTab"
      },
      {
        "title": "Get Picture suggestions",
        "command": "dectox.grabpics"
      },
      {
        "title": "Open Image buffer directory",
        "command": "dectox.reavealBufp"
      },
      {
        "title": "Refresh",
        "command": "dectox.refreshViewBufp"
      },
      {
        "title": "Pinterest test command",
        "command": "decctox.pintest"
      }
    ],
    "configuration": [
      {
        "title": "General",
        "properties": {
          "dectox.Debug": {
            "type": "boolean",
            "default": false,
            "description": "Enforces debug output N prints."
          }
        }
      },
      {
        "title": "ASCII Picturing",
        "properties": {
          "dectox.DepthMethod": {
            "type": "string",
            "description": "Selects depth method.",
            "enum": [
              "rgb/3",
              "Vec3^2 method"
            ],
            "default": "rgb/3"
          },
          "dectox.ASCIILayers": {
            "type": "string",
            "description": "Defines the ordered ascii string being used for your picture projection.",
            "enum": [
              "10",
              "13",
              "14",
              "20",
              "70",
              "71",
              "custom[WIP]"
            ],
            "default": "14"
          },
          "dectox.InvertASCIIOrder": {
            "type": "boolean",
            "description": "Inverts ascii order",
            "default": "true"
          },
          "dectox.PicWidth": {
            "type": "integer",
            "description": "Width of ascii picture.",
            "minimum": 0,
            "default": 50
          },
          "dectox.PicHeight": {
            "type": "integer",
            "description": "Height of ascii picture.",
            "minimum": 0,
            "default": 30
          },
          "dectox.DisableCommentSigns": {
            "type": "boolean",
            "description": "Removes comment sign on start of each line for all file extensions.",
            "default": false
          },
          "dectox.BrowserPath": {
            "type": "string",
            "description": "Path or command to the active browser.",
            "default": "firefox"
          },
          "dectox.RequestDelay": {
            "type": "integer",
            "description": "Delay between repeating web request.",
            "minimum": 100,
            "maximum": 2000,
            "default": 500
          },
          "dectox.ShouldClearBufp": {
            "type": "boolean",
            "description": "Should clear bufp directories from all files when calling Suggestion commands",
            "default": true
          },
          "dectox.OpenBufpFolderAfterRequest": {
            "type": "boolean",
            "description": "Automatically executes revealFileInOS(open in Explorer) folder after Suggestion request",
            "default": false
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "dectox.ChoosePlacePicture",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "dectox.smartTab",
        "key": "shift+right",
        "mac": "cmd+right",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dectoxBar",
          "title": "DecTox",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "dectoxBar": [
        {
          "id": "dectoxGeneral",
          "name": "General",
          "type": "tree",
          "icon": ""
        },
        {
          "id": "dectoxBufp",
          "name": "Buffer folder view",
          "type": "tree",
          "icon": ""
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dectox.refreshViewBufp",
          "group": "navigation",
          "when": "view == dectoxBufp"
        }
      ],
      "view/item/context": [
        {
          "command": "dectox.PlacePic",
          "group": "inline",
          "when": "view == dectoxBufp && viewItem == dectoxImgtp"
        },
        {
          "command": "dectox.PlacePic",
          "when": "view == dectoxBufp && viewItem == dectoxImgtp"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "puppeteer": "^25.11.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "puppeteer-core": "^25.11.0",
    "safi-image": "^0.1.0"
  }
}
