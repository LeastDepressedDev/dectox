{
  "name": "dectox",
  "displayName": "DecTox",
  "description": "VS code: code decoration",
  "publisher": "LeastDepressedDev",
  "author": "LeastDepressedDev",
  "version": "0.0.1",
  "repository": "https://github.com/LeastDepressedDev/dectox",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./build/extension.js",
  "contributes": {
    "commands": [
      {
        "title": "Place picture",
        "command": "dectox.PlacePic"
      },
      {
        "title": "Test ascii conv",
        "command": "dectox.TestAscii"
      }
    ],
    "configuration": [
      {
        "title": "General",
        "properties": {
          "dectox.Debug": {
            "type": "boolean",
            "default": false,
            "description": "Enforces debug output N prints."
          }
        }
      },
      {
        "title": "ASCII Picturing",
        "properties": {
          "dectox.DepthMethod": {
            "type": "string",
            "description": "Selects depth method",
            "enum": ["default(Vec3^2 method)"],
            "default": "default(Vec3^2 method)"
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "dectox.PlacePic",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.90.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
}
