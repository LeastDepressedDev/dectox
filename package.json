{
  "name": "dectox",
  "displayName": "DecTox",
  "description": "VS code: code decoration",
  "publisher": "LeastDepressedDev",
  "author": "LeastDepressedDev",
  "version": "0.0.1",
  "repository": "https://github.com/LeastDepressedDev/dectox",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./build/extension.js",
  "contributes": {
    "commands": [
      {
        "title": "Place picture",
        "command": "dectox.PlacePic"
      },
      {
        "title": "Test ascii conv",
        "command": "dectox.TestAscii"
      }
    ],
    "configuration": [
      {
        "title": "General",
        "properties": {
          "dectox.Debug": {
            "type": "boolean",
            "default": false,
            "description": "Enforces debug output N prints."
          }
        }
      },
      {
        "title": "ASCII Picturing",
        "properties": {
          "dectox.DepthMethod": {
            "type": "string",
            "description": "Selects depth method",
            "enum": [
              "rgb/3",
              "Vec3^2 method"
            ],
            "default": "rgb/3"
          },
          "dectox.PicWidth": {
            "type": "integer",
            "description": "Width of ascii picture",
            "minimum": 0,
            "default": 50
          },
          "dectox.PicHeight": {
            "type": "integer",
            "description": "Height of ascii picture",
            "minimum": 0,
            "default": 30
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "dectox.PlacePic",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bmp-ts": "^1.0.9"
  }
}
